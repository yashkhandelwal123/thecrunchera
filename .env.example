# Postgres connection string from Neon (Phase 2)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=some-long-random-string-here

# Google OAuth Client ID from Google Cloud Console → Credentials.
# Needs to be set twice with the SAME value: GOOGLE_CLIENT_ID is read by the
# server (to verify tokens), VITE_GOOGLE_CLIENT_ID is baked into the frontend
# build (Vite only exposes env vars prefixed VITE_ to the browser bundle).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Razorpay Test Mode keys, from the Razorpay dashboard → Settings → API Keys.
# RAZORPAY_KEY_ID is safe to expose (it's used client-side too via the API
# response), RAZORPAY_KEY_SECRET must stay server-only and private.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Optional but recommended: set this up once you configure a webhook in
# the Razorpay dashboard (Settings → Webhooks). Acts as a safety net if a
# customer's browser closes before payment verification completes. Leave
# blank to skip webhook verification (checkout still works via /verify).
RAZORPAY_WEBHOOK_SECRET=
