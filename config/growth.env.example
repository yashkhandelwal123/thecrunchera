# Local shell / CI secrets only. Never commit filled-in values.
# Supply exactly one of these two service-account credential options:
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Numeric GA4 property ID, NOT a G- measurement ID:
GA4_PROPERTY_ID=
# Optional; needed to enable PageSpeed measurements in this workflow:
PAGESPEED_API_KEY=
