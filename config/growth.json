  "timeout_seconds": 30,
  "pagespeed_paths": [
    "/",
    "/edamame-beans"
  ],
  "pagespeed_strategies": [
    "mobile",
    "desktop"
  ],
  "publishing_enabled": false,
  "allowed_page_paths": [
    "/",
    "/products",
    "/edamame-beans",
    "/blog",
    "/shipping",
    "/about",
    "/contact",
    "/privacy-policy",
    "/terms-of-service"
  ],
  "allowed_path_prefixes": [
    "/products/",
    "/blog/",
    "/product-images/"
  ]
}
